+// Fn+Q at run time. RM reads the cTGP when it starts and again on a GPS status change (ACPI notify 0xC0 on the GPU,
+// which this firmware never sends for a power-mode change). tools/fnq FnQNotify (IOService "FnQNotify") messages its
+// interested clients with kIOMessageServicePropertyChange after each Fn+Q; on that we raise the status change, RM asks
+// PSHARESTATUS/PSHAREPARAMS again and the cTGP of the new mode goes to the GPU. 500 ms delay: a run of presses is one
+// event. The interest notifier and the thread call stay for the life of the kext, like the ACPI node cache below.
+static nv_state_t *nv_xnu_gps_nv;
+static thread_call_t nv_xnu_gps_call;
+static void nv_xnu_gps_fire(thread_call_param_t, thread_call_param_t)
+{
+    NvU32 mw = 0, mode = 0;
+    if (!nv_xnu_ctgp_mw(&mw, &mode)) return;
+    IOLog("NVRM-xnu: GPS Fn+Q: Legion mode %u, status change to RM (cTGP +%u mW)\n", mode, mw);
+    rm_acpi_notify(NULL, nv_xnu_gps_nv, 0xC0 /* ACPI_NOTIFY_GPS_STATUS_CHANGE */);
+}
+static IOReturn nv_xnu_fnq_message(void *, void *, UInt32 type, IOService *, void *, vm_size_t)
+{
+    if (type == kIOMessageServicePropertyChange) {
+        uint64_t deadline;
+        clock_interval_to_deadline(500, kMillisecondScale, &deadline);
+        thread_call_enter_delayed(nv_xnu_gps_call, deadline);
+    }
+    return kIOReturnSuccess;
+}
+static bool nv_xnu_fnq_published(void *, void *, IOService *svc, IONotifier *)
+{
+    static IONotifier *interest;
+    if (!interest) {
+        interest = svc->registerInterest(gIOGeneralInterest, nv_xnu_fnq_message, NULL, NULL);
+        IOLog("NVRM-xnu: GPS Fn+Q watch %s\n", interest ? "on" : "FAILED");
+    }
+    return true;
+}
+static void nv_xnu_gps_watch_fnq(nv_state_t *nv)   // first GPS call under nvrmgps=2 (RM is up, nv is the GPU)
+{
+    if (nv_xnu_gps_nv) return;
+    nv_xnu_gps_nv = nv;
+    nv_xnu_gps_call = thread_call_allocate(nv_xnu_gps_fire, NULL);
+    OSDictionary *m = IOService::serviceMatching("FnQNotify");
+    if (m && nv_xnu_gps_call && !IOService::addMatchingNotification(gIOFirstPublishNotification, m, nv_xnu_fnq_published, NULL))
+        IOLog("NVRM-xnu: GPS Fn+Q watch FAILED (notification)\n");
+    OSSafeReleaseNULL(m);
+}
