+static bool nv_xnu_acpi_gps_on(void) { return nv_xnu_acpi_gps_level() > 0; }
 
+// Lenovo Legion: this firmware's GPS answers only the GPU temperature target; the configurable TGP is handed out by
+// NVPCF, which RM leaves to a closed user-space service. nvrmgps=2 adds the cTGP to GPS PSHAREPARAMS so RM applies it
+// itself (CONFIGURE_TURBO_V2). Offset in mW over the VBIOS default limit: boot-arg nvrmctgp=<mW>, or by the Legion
+// power mode (WMI GetSmartFanMode on \_SB.GZFD, the Fn+Q mode) from the firmware's own cTGP table: 50/65/100 W.
+static bool nv_xnu_lenovo_mode(NvU32 *mode)
+{
+    IORegistryEntry *e = IORegistryEntry::fromPath("IOACPIPlane:/_SB/GZFD");
+    IOACPIPlatformDevice *gz = OSDynamicCast(IOACPIPlatformDevice, e);
+    bool ok = false;
+    if (gz && gz->validateObject("WMAA") == kIOReturnSuccess) {
+        OSObject *args[3] = { OSNumber::withNumber(0ULL, 8), OSNumber::withNumber(0x2DULL, 32), OSNumber::withNumber(0ULL, 32) };
+        OSObject *res = NULL;
+        if (args[0] && args[1] && args[2] && gz->evaluateObject("WMAA", &res, args, 3) == kIOReturnSuccess)
+            if (OSNumber *n = OSDynamicCast(OSNumber, res)) { *mode = n->unsigned32BitValue(); ok = true; }
+        for (OSObject *a : args) OSSafeReleaseNULL(a);
+        OSSafeReleaseNULL(res);
+    }
+    OSSafeReleaseNULL(e);
+    return ok;
+}
+static bool nv_xnu_ctgp_mw(NvU32 *mw, NvU32 *mode)
+{
+    int v = 0; *mode = 0;
+    if (PE_parse_boot_argn("nvrmctgp", &v, sizeof(v)) && v >= 0 && v <= 65000) { *mw = (NvU32)v; return true; }
+    if (!nv_xnu_lenovo_mode(mode)) return false;
+    switch (*mode) {
+        case 1: *mw = 0; return true;                    // Quiet: cTGP 50 W
+        case 2: case 0xFF: *mw = 15000; return true;     // Balanced / Custom: 65 W
+        case 3: case 0xE0: *mw = 50000; return true;     // Performance / Extreme: 100 W
+        default: return false;
+    }
+}
